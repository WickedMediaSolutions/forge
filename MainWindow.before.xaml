<Window x:Class="EvenniaMapMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EvenniaMapMaker.Controls"
        xmlns:converters="clr-namespace:EvenniaMapMaker.Converters"
        xmlns:models="clr-namespace:EvenniaMapMaker.Models"
        Title="{Binding TitleBarText}" Height="750" Width="1200"
        MinHeight="500" MinWidth="900"
        Background="#1E1E1E"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <ToolBarTray Grid.Row="0" Background="#2D2D2D">
            <ToolBar Background="#2D2D2D">
                <Button Content="New" Click="New_Click"/>
                <Button Content="Open" Click="Open_Click"/>
                <Button Content="Save" Click="Save_Click"/>
                <Button Content="Save As" Click="SaveAs_Click"/>
                <Separator/>
                <Button x:Name="BuildBtn" Content="{Binding BuildModeText}" Click="BuildMode_Click" FontWeight="Bold"/>
                <Button Content="{Binding AutoReverseText}" Click="AutoReverse_Click"/>
                <Separator/>
                <Button Content="Floor Up" Click="FloorUp_Click"/>
                <Button Content="Floor Down" Click="FloorDown_Click"/>
                <TextBlock Text="{Binding FloorLabel}" Foreground="#FFD700" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="6,0" FontSize="12"/>
                <Separator/>
                <Button Content="Delete" Click="Delete_Click"/>
                <Separator/>
                <Button Content="Export Evennia" Click="Export_Click"/>
                <Separator/>
                <Button Content="Undo" Click="Undo_Click"/>
                <Button Content="Redo" Click="Redo_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <controls:MapCanvas x:Name="MapCanvasControl" Grid.Column="0" DataContext="{Binding}"/>

            <GridSplitter Grid.Column="1" Width="4" Background="#444444"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
<!-- PROPERTIES PANEL -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#2D2D2D">
                <StackPanel x:Name="PropertiesPanel" Margin="10">

                    <StackPanel Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ROOM PROPERTIES" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="Room ID" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedRoom.Id}" Foreground="#CCC" Background="#3C3C3C" Padding="6,3" Margin="0,0,0,8"/>
                        <TextBlock Text="Title" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="Room Type" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="Description" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="X" Foreground="#999" FontSize="10"/>
                                <TextBlock Text="{Binding SelectedRoomX}" Foreground="#FFD700" FontWeight="Bold" Background="#3C3C3C" Padding="4,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Y" Foreground="#999" FontSize="10"/>
                                <TextBlock Text="{Binding SelectedRoomY}" Foreground="#FFD700" FontWeight="Bold" Background="#3C3C3C" Padding="4,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Z" Foreground="#999" FontSize="10"/>
                                <TextBlock Text="{Binding SelectedRoomZ}" Foreground="#FFD700" FontWeight="Bold" Background="#3C3C3C" Padding="4,3"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Tags" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="Notes" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" Margin="0,0,0,8"/>
                        <TextBlock Text="Exits" FontWeight="Bold" Foreground="White" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding RoomConnections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3C3C3C" BorderBrush="#555" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,3" Cursor="Hand" MouseLeftButtonDown="ConnectionListItem_Click">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" FontSize="11">
                                                <Run Text="{Binding Direction}" Foreground="#FFD700"/>
                                                <Run Text=" -> "/>
                                                <Run Text="{Binding DestinationRoomId}" Foreground="#CCC"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ExitType}" Foreground="#888" FontSize="10"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

<StackPanel Visibility="{Binding IsConnectionSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="EXIT PROPERTIES" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="ID" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedConnection.Id}" Foreground="#CCC" Background="#3C3C3C" Padding="6,3" Margin="0,0,0,8"/>
                        <TextBlock Text="Direction" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="DirectionCombo" SelectionChanged="DirectionCombo_SelectionChanged" Margin="0,0,0,8">
                            <ComboBoxItem Tag="North" Content="North"/><ComboBoxItem Tag="South" Content="South"/>
                            <ComboBoxItem Tag="East" Content="East"/><ComboBoxItem Tag="West" Content="West"/>
                            <ComboBoxItem Tag="Northeast" Content="NE"/><ComboBoxItem Tag="Northwest" Content="NW"/>
                            <ComboBoxItem Tag="Southeast" Content="SE"/><ComboBoxItem Tag="Southwest" Content="SW"/>
                            <ComboBoxItem Tag="Up" Content="Up"/><ComboBoxItem Tag="Down" Content="Down"/>
                        </ComboBox>
                        <TextBlock Text="Aliases" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedConnectionAliases, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="Exit Type" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ExitTypeCombo" SelectionChanged="ExitTypeCombo_SelectionChanged" Margin="0,0,0,8">
                            <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Door"/>
                        </ComboBox>
                        <CheckBox Content="One Way" IsChecked="{Binding SelectedConnectionIsOneWay}" Margin="0,0,0,8"/>
                        <StackPanel Visibility="{Binding ShowDoorProperties, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DOOR" FontWeight="Bold" Foreground="#FFD700" Margin="0,8,0,6"/>
                            <TextBlock Text="Door Name" Foreground="#999" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding SelectedConnectionDoorName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                            <CheckBox Content="Starts Open" IsChecked="{Binding SelectedConnectionStartsOpen}" Margin="0,0,0,4"/>
                            <CheckBox Content="Starts Closed" IsChecked="{Binding SelectedConnectionStartsClosed}" Margin="0,0,0,4"/>
                            <CheckBox Content="Starts Locked" IsChecked="{Binding SelectedConnectionStartsLocked}" Margin="0,0,0,4"/>
                            <TextBlock Text="Key ID" Foreground="#999" FontSize="10" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding SelectedConnectionKeyId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="NoSelText" Text="Select a room or connection to edit properties." Foreground="#888" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#2D2D2D" BorderBrush="#444" BorderThickness="0,1,0,0" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Foreground="#CCC" FontSize="11"/>
                <TextBlock Text="   " Foreground="#555"/>
                <TextBlock Text="{Binding BuildModeText}" Foreground="#FFD700" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="  " Foreground="#555"/>
                <TextBlock Text="{Binding AutoReverseText}" Foreground="#88BBFF" FontSize="11"/>
                <TextBlock Text="  " Foreground="#555"/>
                <TextBlock Text="{Binding FloorLabel}" Foreground="#88FF88" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
