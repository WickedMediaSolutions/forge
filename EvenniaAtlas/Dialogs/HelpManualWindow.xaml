<Window x:Class="EvenniaAtlas.Dialogs.HelpManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rites of Passage: The Forge — User Manual" Width="600" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        Background="#232326" WindowStyle="ToolWindow">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <!-- Heading -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Background="#4CAF50" Width="4" CornerRadius="1"
                        VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                <TextBlock Text="Rites of Passage: The Forge User Manual"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#E0E0E0" TextWrapping="Wrap"/>
            </StackPanel>

            <Separator Background="#3E3E42" Height="1" Margin="0,0,0,16"/>

            <!-- Table of Contents -->
            <TextBlock Text="Table of Contents" FontSize="14" FontWeight="SemiBold"
                       Foreground="#B0B0B0" Margin="0,0,0,12"/>

            <StackPanel Margin="8,0,0,0">
                <TextBlock Text="Getting Started" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Projects" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Map &amp; Room Editing" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Connections &amp; Exits" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Item Spawns" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="NPC Spawns" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Item Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="NPC Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Shop Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Loot Table Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Quest Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Dialogue Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Game Data Editor" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Validation" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Evennia Export" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Keyboard Shortcuts" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
                <TextBlock Text="Troubleshooting" FontSize="12" Foreground="#808080" Margin="0,0,0,6"/>
            </StackPanel>
            <Separator Background="#3E3E42" Height="1" Margin="0,16,0,16"/>

            <!-- ============================================ -->
            <!-- Getting Started Section                      -->
            <!-- ============================================ -->

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#4CAF50" Width="4" CornerRadius="1"
                        VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                <TextBlock Text="Getting Started" FontSize="14" FontWeight="SemiBold"
                           Foreground="#B0B0B0" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="What Is Rites of Passage: The Forge?" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Rites of Passage: The Forge is an offline world-building editor for the Evennia multi-user game engine. It provides a visual interface for designing rooms, connecting exits, placing NPC and item spawns, editing game data, and exporting directly to Evennia batch-build commands. All work is stored in a single, portable project file."/>
            </TextBlock>

            <TextBlock Text="Main Window Areas" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The main window is divided into several areas:"/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Menu Bar "/><Run Text="— File, Edit, View, Tools, and Help menus across the top of the window."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Room List "/><Run Text="— A tree or list on the left side showing all rooms in the project. Click a room to select and edit it."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Map Canvas "/><Run Text="— The central area where rooms appear as nodes. Drag rooms to arrange them, and draw exit connections between them."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Properties Panel "/><Run Text="— Displays and lets you edit the selected room's attributes: name, description, coordinates, and other data."/>
            </TextBlock>
<TextBlock Text="Creating and Opening a Project" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="To start a new world, go to "/><Run FontWeight="SemiBold" Text="File → New Project"/><Run Text=". You will be prompted to choose a location and name for the new project file. Once created, an empty world with a single starting room is ready for editing."/>
                <LineBreak/><LineBreak/>
                <Run Text="To continue working on an existing project, use "/><Run FontWeight="SemiBold" Text="File → Open Project"/><Run Text=" and select the project file. The editor restores your rooms, exits, and all game data exactly as you left it."/>
            </TextBlock>

            <TextBlock Text="Saving Your Work" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Save the current project with "/><Run FontWeight="SemiBold" Text="File → Save"/><Run Text=" (or "/><Run FontWeight="SemiBold" Text="Ctrl+S"/><Run Text="). If the project has never been saved before, this behaves like Save As and asks for a file location."/>
                <LineBreak/><LineBreak/>
                <Run Text="Use "/><Run FontWeight="SemiBold" Text="File → Save As"/><Run Text=" to save a copy of the project under a new name or location. The editor continues working with the newly saved file."/>
            </TextBlock>

            <TextBlock Text="The Dirty Indicator" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,6" TextWrapping="Wrap">
                <Run Text="Whenever you make a change that has not yet been saved, an asterisk (★) appears in the window title bar next to the project name — for example, "/><Run FontStyle="Italic" Text="MyWorld.forge ★"/><Run Text=". This dirty marker is your visual cue that the current state differs from the file on disk."/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Once you save (File → Save or Ctrl+S), the star disappears. If you close the application or open another project while the star is showing, you will be prompted to save first. The indicator resets only when the in-memory project exactly matches the saved file."/>
            </TextBlock>
<Separator Background="#3E3E42" Height="1" Margin="0,16,0,16"/>

            <!-- ============================================ -->
            <!-- Projects Section                              -->
            <!-- ============================================ -->

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#4CAF50" Width="4" CornerRadius="1"
                        VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                <TextBlock Text="Projects" FontSize="14" FontWeight="SemiBold"
                           Foreground="#B0B0B0" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="New Project" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Creates a blank project from scratch. Go to "/><Run FontWeight="SemiBold" Text="File → New Project"/><Run Text=". A save dialog opens so you can choose where to create the project file and what to name it. The new project starts with a single default room placed on the map canvas, ready for editing."/>
            </TextBlock>

            <TextBlock Text="Open Project" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Opens an existing project file. Use "/><Run FontWeight="SemiBold" Text="File → Open Project"/><Run Text=" and browse to the project file. The editor loads all rooms, exits, spawns, game data, and other saved content from the file. If the currently open project has unsaved changes, you are prompted to save or discard them before the new project loads."/>
            </TextBlock>
            <TextBlock Text="Save" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Writes the current state of the project to its associated file on disk. Use "/><Run FontWeight="SemiBold" Text="File → Save"/><Run Text=" or press "/><Run FontWeight="SemiBold" Text="Ctrl+S"/><Run Text=". If the project has not been saved before (no file path is set), Save behaves identically to Save As and opens a file-save dialog."/>
            </TextBlock>

            <TextBlock Text="Save As" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Saves the project to a new file while keeping the original untouched. Use "/><Run FontWeight="SemiBold" Text="File → Save As"/><Run Text=". A save dialog lets you choose a new name or location. After Save As completes, the editor switches to the new file — all subsequent saves go to that new path."/>
            </TextBlock>

            <TextBlock Text="Unsaved-Change Prompts" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The editor tracks whether the current project has been modified since the last save. In the following situations, a confirmation dialog appears:"/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Closing the window "/><Run Text="— You are asked whether to save, discard, or cancel."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Opening a different project "/><Run Text="— You are asked to save the current project first."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Starting a New Project "/><Run Text="— Same prompt: save changes before creating the new project."/>
                <LineBreak/>
                <Run Text="Each prompt offers three choices: "/><Run FontWeight="SemiBold" Text="Save"/><Run Text=" (saves and continues), "/><Run FontWeight="SemiBold" Text="Don't Save"/><Run Text=" (discards all unsaved changes and continues), or "/><Run FontWeight="SemiBold" Text="Cancel"/><Run Text=" (aborts the operation and returns to the editor)."/>
            </TextBlock>

            <TextBlock Text="Project File Behavior" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The Forge stores all project data in a single file. This file contains every room, exit, NPC spawn, item spawn, game-data definition, and editor setting. The file is self-contained and portable — you can move it to another machine, share it with collaborators, or back it up like any normal file. No external database or configuration is required."/>
            </TextBlock>

            <TextBlock Text="Atomic Save Protection" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,6" TextWrapping="Wrap">
                <Run Text="When you save, the editor never writes directly over the existing file. Instead, it writes the complete project to a temporary file first. Only after the write succeeds fully is the temporary file renamed to replace the original project file."/>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="This atomic save strategy protects your data in case of a crash or power loss during the save operation. The original file remains intact until the new version is safely on disk, so you never end up with a partial or corrupted project file."/>
            </TextBlock>

<!-- ============================================ -->
            <!-- Map & Room Editing Section                   -->
            <!-- ============================================ -->

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#4CAF50" Width="4" CornerRadius="1"
                        VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                <TextBlock Text="Map &amp; Room Editing" FontSize="14" FontWeight="SemiBold"
                           Foreground="#B0B0B0" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="Overview" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Map and room editing is the core workflow in The Forge. The main window provides a "/><Run FontWeight="SemiBold" Text="Room List"/><Run Text=" on the left, a large "/><Run FontWeight="SemiBold" Text="Map Canvas"/><Run Text=" in the center, and a "/><Run FontWeight="SemiBold" Text="Properties Panel"/><Run Text=" on the right. Together, these three areas let you navigate, arrange, and configure every room in your world. Most actions are also available through the right-click context menu on rooms in both the Room List and the Map Canvas."/>
            </TextBlock>

            <!-- Room List -->
            <TextBlock Text="Room List" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Room List"/><Run Text=" is a tree-view panel docked to the left side of the main window. It shows every room in the current project, organized hierarchically. Each room is displayed with its name and, if assigned, its room ID. A search bar at the top of the Room List lets you filter rooms by name — type any part of a room name to narrow the list in real time."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click "/><Run Text="any room in the Room List to open a context menu with commands for creating, deleting, and centering on that room."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Double-click "/><Run Text="a room to center the map view on that room."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Single-click "/><Run Text="a room to select it for editing; its properties appear in the Properties Panel and it is highlighted on the Map Canvas."/>
                <LineBreak/>
                <Run Text="• The list supports "/><Run FontWeight="SemiBold" Text="multi-select"/><Run Text=" via Ctrl+Click or Shift+Click so you can delete or move several rooms at once."/>
            </TextBlock>
<!-- Map Canvas -->
            <TextBlock Text="Map Canvas" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Map Canvas"/><Run Text=" is the large central area where rooms are displayed as interactive nodes. Each room appears as a rectangular card showing its name, type, and ID. Exit connections are drawn as lines with arrows between room nodes. The canvas supports panning, zooming, and direct manipulation of rooms."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Pan "/><Run Text="the canvas by clicking and dragging on empty space, or by holding the middle mouse button and moving."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Zoom "/><Run Text="in and out using the mouse scroll wheel. Zoom centers on the cursor position for precise control."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click "/><Run Text="empty canvas space to open a context menu for creating a new room at that position."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click "/><Run Text="a room node to open a context menu with room-specific commands (center, delete, edit properties, and draw exits)."/>
                <LineBreak/>
                <Run Text="• A "/><Run FontWeight="SemiBold" Text="coordinated crosshair"/><Run Text=" follows the mouse cursor on the canvas, showing the world coordinates of the current position. This helps you place rooms at precise coordinates."/>
            </TextBlock>

            <!-- Selecting Rooms -->
            <TextBlock Text="Selecting Rooms" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="You can select a room in several ways. The currently selected room is highlighted in both the Room List and the Map Canvas, and its properties populate the Properties Panel."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Single-click "/><Run Text="a room in the Room List."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Single-click "/><Run Text="a room node on the Map Canvas."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Ctrl+Click or Shift+Click "/><Run Text="rooms in the Room List or on the canvas to select multiple rooms simultaneously. Multi-select is useful for batch deleting or moving several rooms at once."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Ctrl+A "/><Run Text="on the canvas selects all rooms."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Click empty canvas space "/><Run Text="to clear the current selection."/>
            </TextBlock>

            <!-- Creating Rooms -->
            <TextBlock Text="Creating Rooms" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="New rooms can be created in several ways. Every new room receives a default name and a unique room ID, and is placed at the specified coordinates on the map."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click empty canvas space "/><Run Text="and choose "/><Run FontWeight="SemiBold" Text="Add Room"/><Run Text=". The new room appears where you clicked."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click a room in the Room List "/><Run Text="and choose "/><Run FontWeight="SemiBold" Text="Add Room"/><Run Text=". The new room is added at default coordinates."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Choose Edit → Add Room "/><Run Text="from the menu bar."/>
                <LineBreak/>
                <Run Text="• Press "/><Run FontWeight="SemiBold" Text="Ctrl+N"/><Run Text=" to create a new room at default coordinates."/>
                <LineBreak/>
                <Run Text="• Use "/><Run FontWeight="SemiBold" Text="Build Mode"/><Run Text=" (described below) for rapid, click-to-place room creation."/>
            </TextBlock>
<!-- Moving Rooms -->
            <TextBlock Text="Moving Rooms" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Rooms can be repositioned freely on the Map Canvas. Moving a room updates its world coordinates automatically."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Click and drag "/><Run Text="a room node on the canvas to move it. Release the mouse button to place the room at the new position."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Select multiple rooms "/><Run Text="then drag any one of them to move the entire group together. All selected rooms maintain their relative positions as you drag."/>
                <LineBreak/>
                <Run Text="• You can also set exact coordinates by typing values into the "/><Run FontWeight="SemiBold" Text="X"/><Run Text=", "/><Run FontWeight="SemiBold" Text="Y"/><Run Text=", and "/><Run FontWeight="SemiBold" Text="Z"/><Run Text=" fields in the Properties Panel when a room is selected."/>
                <LineBreak/>
                <Run Text="• Exit connections automatically follow when a room is moved — the lines redraw to stay connected to the room's new position."/>
            </TextBlock>

            <!-- Deleting Rooms -->
            <TextBlock Text="Deleting Rooms" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Deleting a room removes it permanently from the project. Any exit connections that involve the deleted room are also removed."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click a room "/><Run Text="on the canvas or in the Room List and choose "/><Run FontWeight="SemiBold" Text="Delete Room"/><Run Text="."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Select a room "/><Run Text="and press the "/><Run FontWeight="SemiBold" Text="Delete"/><Run Text=" key."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Select multiple rooms "/><Run Text="and press Delete or use the context menu to remove them all at once."/>
                <LineBreak/>
                <Run Text="• A confirmation dialog appears before deletion to prevent accidental removal."/>
            </TextBlock>

            <!-- Editing Room Properties -->
            <TextBlock Text="Editing Room Properties" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="When a room is selected, the "/><Run FontWeight="SemiBold" Text="Properties Panel"/><Run Text=" on the right side of the window displays all of its editable fields. Changes take effect immediately and are tracked for undo/redo."/>
            </TextBlock>

            <TextBlock Text="Room ID" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Each room has a unique "/><Run FontWeight="SemiBold" Text="Room ID"/><Run Text=". This ID is used to reference the room in exits, spawns, and game-data entries. The editor auto-generates IDs for new rooms, but you can type a custom ID in the Properties Panel. Room IDs must be unique across the entire project — the editor warns you if you enter a duplicate."/>
            </TextBlock>

            <TextBlock Text="Title / Name" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Title"/><Run Text=" (or Name) field sets the room's display name. This is the name players see when they enter the room in-game. Room names appear on the room nodes on the Map Canvas and in the Room List. The name does not need to be unique — multiple rooms can share the same name."/>
            </TextBlock>
<TextBlock Text="Room Type" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Type"/><Run Text=" field categorizes the room. Built-in options include standard room types such as "/><Run FontWeight="SemiBold" Text="Room"/><Run Text=", "/><Run FontWeight="SemiBold" Text="Hub"/><Run Text=", "/><Run FontWeight="SemiBold" Text="Shop"/><Run Text=", and "/><Run FontWeight="SemiBold" Text="Wilderness"/><Run Text=". The type controls which Evennia typeclass the room uses when exported, and it is displayed on the room node on the Map Canvas for quick visual identification."/>
            </TextBlock>

            <TextBlock Text="Description" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Description"/><Run Text=" field contains the room's in-game description — the flavor text that players see when they enter the room or use the "/><Run FontWeight="SemiBold" Text="look"/><Run Text=" command. It is a multi-line text area in the Properties Panel. You can write rich descriptive text to establish atmosphere, detail the environment, or provide narrative clues."/>
            </TextBlock>

            <TextBlock Text="Coordinates (X, Y, Z)" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Every room has three coordinate fields: "/><Run FontWeight="SemiBold" Text="X"/><Run Text=" (east-west), "/><Run FontWeight="SemiBold" Text="Y"/><Run Text=" (north-south), and "/><Run FontWeight="SemiBold" Text="Z"/><Run Text=" (floor or elevation). These values determine where the room appears on the Map Canvas and are exported to Evennia as the room's spatial coordinates."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="X and Y "/><Run Text="position the room horizontally and vertically on the map. Drag a room on the canvas to change these values visually, or type exact numbers into the fields."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Z "/><Run Text="controls the floor or elevation level (see Floors / Z-Level Navigation below)."/>
            </TextBlock>
<TextBlock Text="Tags" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Tags"/><Run Text=" field lets you assign one or more tags to a room. Tags are short, comma-separated labels that can be used to categorize rooms for gameplay logic, quests, or export filtering. For example, a tag like "/><Run FontWeight="SemiBold" Text="indoors"/><Run Text=", "/><Run FontWeight="SemiBold" Text="safe_zone"/><Run Text=", or "/><Run FontWeight="SemiBold" Text="dungeon"/><Run Text=" can be read by in-game scripts. Tags are exported to Evennia as part of the room's data."/>
            </TextBlock>

            <TextBlock Text="Notes" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Notes"/><Run Text=" field is a free-form, multi-line text area for your own design notes. Notes are not exported to Evennia — they are purely for your reference during world-building. Use this field to jot down quest ideas, trap descriptions, NPC schedules, or any other planning information tied to the room."/>
            </TextBlock>

            <!-- Floors / Z-Level Navigation -->
            <TextBlock Text="Floors / Z-Level Navigation" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The Z coordinate represents vertical layers — floors, levels, or elevation. The Map Canvas displays one Z-level at a time, letting you build multi-story dungeons, towers, or layered overworlds."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Floor selector "/><Run Text="— A control near the canvas (typically a numeric up/down or a dropdown) lets you switch the current floor view. The canvas shows only rooms whose Z coordinate matches the current floor."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Changing floors "/><Run Text="hides rooms on other Z-levels from the canvas, but all rooms remain listed in the Room List regardless of the current floor."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Exits between floors "/><Run Text="— You can connect rooms on different Z-levels with exits. When you view one floor, exits leading to rooms on other floors still display on the canvas."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Stair-like navigation "/><Run Text="— Use Z-levels to model stairs, elevators, ladders, or multi-level terrain by placing rooms at different Z values and linking them with exits."/>
            </TextBlock>
<!-- Zoom -->
            <TextBlock Text="Zoom" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The Map Canvas supports smooth zooming to help you work at any scale, from inspecting a single room up close to viewing the entire world at a glance."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Scroll wheel "/><Run Text="— Roll the mouse wheel forward to zoom in, backward to zoom out. Zoom centers on the cursor position so you can target a specific area while zooming."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Zoom level indicator "/><Run Text="— The current zoom percentage may be shown in a status area near the canvas."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Zoom limits "/><Run Text="— There are minimum and maximum zoom levels to keep the map usable; you cannot zoom infinitely in or out."/>
            </TextBlock>

            <!-- Fit Map -->
            <TextBlock Text="Fit Map" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Fit Map"/><Run Text=" command automatically adjusts the canvas zoom and scroll position so that every room in the current floor is visible within the viewport. This is useful when you have zoomed or panned far away and want to see the entire map at once."/>
                <LineBreak/><LineBreak/>
                <Run Text="• Access Fit Map from the "/><Run FontWeight="SemiBold" Text="View → Fit Map"/><Run Text=" menu."/>
                <LineBreak/>
                <Run Text="• The zoom level is calculated to fit all rooms comfortably with a small margin around the edges."/>
                <LineBreak/>
                <Run Text="• If no rooms exist on the current floor, the view resets to the default zoom level and position."/>
            </TextBlock>

            <!-- Center Selected -->
            <TextBlock Text="Center Selected" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Center Selected"/><Run Text=" command pans the Map Canvas so that the currently selected room is at the center of the viewport. It does not change the zoom level."/>
                <LineBreak/><LineBreak/>
                <Run Text="• Access Center Selected from the "/><Run FontWeight="SemiBold" Text="View → Center Selected"/><Run Text=" menu."/>
                <LineBreak/>
                <Run Text="• You can also "/><Run FontWeight="SemiBold" Text="double-click "/><Run Text="a room in the Room List to center on it."/>
                <LineBreak/>
                <Run Text="• Right-click a room on the canvas or in the Room List and choose "/><Run FontWeight="SemiBold" Text="Center"/><Run Text=" from the context menu."/>
                <LineBreak/>
                <Run Text="• If multiple rooms are selected, the view centers on the first room in the selection."/>
            </TextBlock>

            <!-- Build Mode -->
            <TextBlock Text="Build Mode" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Build Mode is a special editing mode for rapidly placing rooms on the Map Canvas. When Build Mode is active, every click on empty canvas space creates a new room — no context menu or extra step is needed."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Toggle Build Mode "/><Run Text="from the "/><Run FontWeight="SemiBold" Text="Edit → Build Mode"/><Run Text=" menu, or by pressing the Build Mode toolbar button if available."/>
                <LineBreak/>
                <Run Text="• While Build Mode is on, the cursor changes to indicate you are in placement mode, and a visual indicator (such as a highlight or label) may appear on the canvas."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Click on empty canvas space "/><Run Text="to create a new room at that location. Each click places one room with default properties."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Clicking on an existing room "/><Run Text="while in Build Mode selects that room instead of creating a new one."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Exit Build Mode "/><Run Text="by toggling it off via the menu, pressing Escape, or switching to another tool."/>
                <LineBreak/>
                <Run Text="• Build Mode is ideal for quickly sketching out the geography of a new area before refining individual room details."/>
            </TextBlock>
            <!-- ============================================ -->
            <!-- Connections & Exits Section                   -->
            <!-- ============================================ -->

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Background="#4CAF50" Width="4" CornerRadius="1"
                        VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                <TextBlock Text="Connections &amp; Exits" FontSize="14" FontWeight="SemiBold"
                           Foreground="#B0B0B0" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock Text="Overview" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Connections (also called exits) link rooms together and define how players and NPCs navigate your world. Each connection has a direction, a source room, and a destination room. The Forge supports all ten standard Evennia directions and offers both automatic and manual creation methods."/>
            </TextBlock>

            <!-- Creating Connections -->
            <TextBlock Text="Creating Connections" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Exits can be created in several ways. All exit creation funnels through a single centralized method, ensuring consistent behavior regardless of which workflow you use."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click a room "/><Run Text="on the canvas or in the Room List and choose "/><Run FontWeight="SemiBold" Text="Add Exit"/><Run Text=". A DirectionChooserDialog pops up where you pick a direction and a destination room from a list."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Compass buttons "/><Run Text="on the map toolbar provide quick directional navigation. Clicking a compass direction (NW/N/NE/W/&#x2022;/E/SW/S/SE + UP/DOWN) navigates to the neighboring room in that direction. If no connection exists yet, one is created automatically. In Build Mode, if no room exists in that direction, a new room is created and connected."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Keyboard numpad "/><Run Text="(1&#x2013;9 for eight cardinal directions, arrow keys for N/S/E/W, PageUp/PageDown for Up/Down) works the same way as the compass &#x2014; navigate, connect, or build as needed."/>
                <LineBreak/>
                <Run Text="• Each new connection receives a unique connection ID and automatically calculates its "/><Run FontWeight="SemiBold" Text="ReverseDirection"/><Run Text=" (the opposite direction needed to return from the destination back to the source)."/>
            </TextBlock>

            <!-- Selecting Connections -->
            <TextBlock Text="Selecting Connections" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="You can select a connection to view and edit its properties. Selecting a connection deselects any currently selected room, and vice versa."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Click a connector line "/><Run Text="on the Map Canvas. The line has a transparent hit-test area that makes it easy to target even thin lines. The selected connection line is highlighted."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="In the Room EXITS panel"/><Run Text=", each outgoing exit for the currently selected room is listed. Click any exit in the list to select that connection."/>
                <LineBreak/>
                <Run Text="• When selected, the "/><Run FontWeight="SemiBold" Text="Properties Panel"/><Run Text=" switches to show exit properties: Id, Source, Destination, Direction, KeyName, Description, Aliases, Exit Type, and One-Way status."/>
            </TextBlock>

            <!-- Editing Exit Direction and Name -->
            <TextBlock Text="Editing Exit Direction and Name" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="When a connection is selected, the Properties Panel provides fields for editing its direction and identifying name:"/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Direction "/><Run Text="— A dropdown with all ten directions: North, South, East, West, Northeast, Northwest, Southeast, Southwest, Up, and Down. Changing the direction automatically updates the calculated ReverseDirection on the paired exit (if one exists)."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="KeyName "/><Run Text="— An optional name for the exit (e.g., 'oak door', 'dark tunnel'). When exported to Evennia, the KeyName becomes the exit's key; if left empty, the direction string is used as a fallback."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Description "/><Run Text="— An optional description shown to players when they look at or approach the exit."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Aliases "/><Run Text="— Comma-separated alternate names for the exit (Atlas convenience field). For example, an exit named 'oak door' could have aliases like 'door, exit, out'."/>
                <LineBreak/>
                <Run Text="• All property changes support "/><Run FontWeight="SemiBold" Text="undo/redo"/><Run Text=". Direction and One-Way changes are treated as atomic undo operations; text fields use coalescing so that only the before/after values are stored."/>
            </TextBlock>
<!-- Source and Destination Rooms -->
            <TextBlock Text="Source and Destination Rooms" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Every connection links two rooms: a "/><Run FontWeight="SemiBold" Text="source"/><Run Text=" (where the exit originates) and a "/><Run FontWeight="SemiBold" Text="destination"/><Run Text=" (where it leads)."/>
                <LineBreak/><LineBreak/>
                <Run Text="• The source and destination room IDs are displayed as read-only fields in the exit properties panel."/>
                <LineBreak/>
                <Run Text="• When a room is selected, its "/><Run FontWeight="SemiBold" Text="EXITS panel"/><Run Text=" (located in the Properties Panel) lists all outgoing connections from that room. Each listed exit shows its direction and destination room ID."/>
                <LineBreak/>
                <Run Text="• Moving a room on the canvas automatically keeps all of its connections intact — the connector lines redraw to follow the room to its new position."/>
            </TextBlock>

            <!-- One-Way vs Reverse Connections -->
            <TextBlock Text="One-Way vs Bidirectional Connections" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="By default, connections are "/><Run FontWeight="SemiBold" Text="bidirectional"/><Run Text=" — traveling from room A to room B implies a return path from B back to A. The Forge lets you toggle exits as one-way for cases like trap doors, chutes, or narrative restrictions."/>
                <LineBreak/><LineBreak/>
                <Run Text="• The "/><Run FontWeight="SemiBold" Text="One-Way"/><Run Text=" checkbox in the exit Properties Panel marks a connection as one-directional."/>
                <LineBreak/>
                <Run Text="• A "/><Run FontWeight="SemiBold" Text="one-way exit"/><Run Text=" does not require a reverse connection. It simply goes from source to destination with no automatic return path."/>
                <LineBreak/>
                <Run Text="• A "/><Run FontWeight="SemiBold" Text="bidirectional exit"/><Run Text=" (One-Way unchecked) is expected to have a matching reverse connection. The Forge validates that bidirectional exits have a paired reverse connection — if one is missing, a validation error (C008) is raised."/>
                <LineBreak/>
                <Run Text="• The "/><Run FontWeight="SemiBold" Text="ReverseDirection"/><Run Text=" field is automatically calculated (North ↔ South, Northeast ↔ Southwest, Up ↔ Down, etc.) and is shown on the reverse connection in its paired exit."/>
                <LineBreak/>
                <Run Text="• You can edit the "/><Run FontWeight="SemiBold" Text="IsOneWay"/><Run Text=" property after creation — changes are undoable."/>
            </TextBlock>

            <!-- Auto Reverse -->
            <TextBlock Text="Auto Reverse" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The "/><Run FontWeight="SemiBold" Text="Auto Reverse"/><Run Text=" feature automatically creates the matching return exit whenever you create a new connection. It is "/><Run FontWeight="SemiBold" Text="ON by default"/><Run Text=" and is indicated by an LED-style status light on the toolbar."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Toggle Auto Reverse"/><Run Text=" by clicking the AUTO REVERSE button on the toolbar. The button shows an LED that glows when Auto Reverse is active and is dim when off."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="When ON: "/><Run Text="Creating a connection from A → B (direction North, for example) automatically creates a matching reverse connection from B → A (direction South), with the same exit type and a shared door identifier."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="When OFF: "/><Run Text="Only the requested direction is created. No reverse connection is generated. This is useful when you want to manually control connections or create one-way exits."/>
                <LineBreak/>
                <Run Text="• Auto Reverse only affects "/><Run FontWeight="SemiBold" Text="newly created"/><Run Text=" connections. It does not retroactively add reverses to existing imported connections, and turning it off does not remove any existing reverse exits."/>
                <LineBreak/>
                <Run Text="• The status bar also displays "/><Run FontWeight="SemiBold" Text="Auto-R: ON"/><Run Text=" or "/><Run FontWeight="SemiBold" Text="Auto-R: OFF"/><Run Text=" for quick reference."/>
            </TextBlock>

            <!-- Deleting Connections -->
            <TextBlock Text="Deleting Connections" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="Connections can be deleted individually or as paired sets."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Right-click a connector line "/><Run Text="on the Map Canvas to open the connector context menu, then choose "/><Run FontWeight="SemiBold" Text="Delete"/><Run Text="."/>
                <LineBreak/>
                <Run Text="• If the connection is bidirectional (shared via a door ID), the context menu offers "/><Run FontWeight="SemiBold" Text="Delete Both"/><Run Text=" to remove both halves of the paired exit at once. The paired reverse is identified through structural matching: source/destination swapped + direction matches ReverseDirection."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Select a connection "/><Run Text="and press the "/><Run FontWeight="SemiBold" Text="Delete"/><Run Text=" key."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Deleting a room "/><Run Text="also cascade-deletes all connections that reference that room as either source or destination."/>
                <LineBreak/>
                <Run Text="• Deletion is "/><Run FontWeight="SemiBold" Text="undoable"/><Run Text=" — using Undo restores both the deleted connection and its paired reverse (if one was removed)."/>
            </TextBlock>

            <!-- Cross-Floor Connections -->
            <TextBlock Text="Cross-Floor Connections" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The Forge supports multi-floor worlds through its Z-level (floor) system. Connections can link rooms on different floors using the Up and Down directions."/>
                <LineBreak/><LineBreak/>
                <Run Text="• Use the "/><Run FontWeight="SemiBold" Text="Up"/><Run Text=" and "/><Run FontWeight="SemiBold" Text="Down"/><Run Text=" compass buttons or keyboard shortcuts (PageUp/PageDown) to create vertical connections between rooms on different Z levels."/>
                <LineBreak/>
                <Run Text="• When you navigate vertically to an existing room on another floor, The Forge automatically switches the active floor to match the destination, and a cross-floor connection is created."/>
                <LineBreak/>
                <Run Text="• In Build Mode, navigating Up or Down to empty space creates a new room on that floor and connects it — the floor view switches to the newly created room's Z level."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="U/D badges "/><Run Text="appear on room nodes that have vertical exits. Clicking a U or D badge selects the destination room, switches the floor view, and centers the map on the destination."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Vertical connection lines "/><Run Text="(Up/Down exits) are "/><Run FontWeight="SemiBold" Text="not drawn"/><Run Text=" as lines on the canvas because the source and destination rooms exist on different floors. The U/D badges serve as the visual indicator instead."/>
            </TextBlock>

            <!-- How Connections Appear on the Map -->
            <TextBlock Text="How Connections Appear on the Map" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The Map Canvas renders connections as lines between room nodes, with visual cues that convey important information at a glance."/>
                <LineBreak/><LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Standard exits "/><Run Text="are drawn as solid lines connecting the two rooms."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="One-way exits "/><Run Text="display a directional arrow indicator along the line, showing which direction the exit flows."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Door exits "/><Run Text="are drawn with "/><Run FontWeight="SemiBold" Text="dashed brown lines"/><Run Text=", visually distinguishing them from normal exits."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Bidirectional pairs "/><Run Text="(where both rooms have exits linking to each other in opposite directions) are "/><Run FontWeight="SemiBold" Text="deduplicated to a single visual line"/><Run Text=" on the canvas, keeping the map clean and readable."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="Connection lines are only drawn for same-floor exits. "/><Run Text="Vertical (Up/Down) connections are not rendered as lines; instead, U and D badges appear on the room nodes."/>
                <LineBreak/>
                <Run Text="• The canvas applies "/><Run FontWeight="SemiBold" Text="Z-level filtering"/><Run Text=" — only rooms and connections on the currently active floor are displayed. Switch floors to see connections on other levels."/>
                <LineBreak/>
                <Run Text="• Connector lines have a transparent hit-test area wider than the visual line itself, making them easy to click for selection even at low zoom levels."/>
                <LineBreak/>
                <Run Text="• Exit lines automatically redraw when rooms are moved, and the map supports viewport-aware culling for performance on large maps."/>
            </TextBlock>

            <!-- Connection Validation -->
            <TextBlock Text="Connection Validation" FontSize="13"
                       FontWeight="SemiBold" Foreground="#B0B0B0" Margin="8,12,0,4"/>
            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
                <Run Text="The Forge includes a read-only validation system that checks all connections for common issues. Run validation from the toolbar or menu at any time — it never modifies your map data."/>
                <LineBreak/><LineBreak/>
                <Run Text="Connection validation rules:"/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C001 — Empty connection ID (ERROR)"/><Run Text=": The connection has no identifier."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C002 — Duplicate connection ID (ERROR)"/><Run Text=": Two connections share the same ID."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C003 — Missing source room (ERROR)"/><Run Text=": The exit references a source room that does not exist."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C004 — Missing destination room (ERROR)"/><Run Text=": The exit references a destination room that does not exist."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C005 — Self-connection (WARNING)"/><Run Text=": The source and destination are the same room."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C006 — Direction mismatch (ERROR)"/><Run Text=": The connection's assigned direction does not match the actual coordinate delta between source and destination."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C007 — Duplicate direction from same source (ERROR)"/><Run Text=": The same room has multiple exits with the same direction. Only one exit per direction is allowed."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C008 — Missing reverse for bidirectional exit (ERROR)"/><Run Text=": A bidirectional (non-one-way) exit has no matching reverse connection. Every bidirectional exit needs a paired return path."/>
                <LineBreak/>
                <Run Text="• "/><Run FontWeight="SemiBold" Text="C009 — Reverse exit marked as one-way (WARNING)"/><Run Text=": The reverse side of a bidirectional exit has its One-Way flag set, which is inconsistent."/>
                <LineBreak/><LineBreak/>
                <Run Text="Validation results appear in a scrollable dialog. Each issue includes a severity level (Error or Warning), a code, a human-readable message, and the IDs of the affected rooms and connections for quick navigation."/>
            </TextBlock>

<!-- ============================================ -->
            <!-- Item Spawns Section                          -->
            <!-- ============================================ -->

            <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
                <Border Background="#4CAF50" Width="4" CornerRadius="1"
                        VerticalAlignment="Stretch" Margin="0,0,10,0"/>
                <TextBlock Text="Item Spawns" FontSize="14" FontWeight="SemiBold"
                           Foreground="#D0D0D0"/>
            </StackPanel>

            <TextBlock FontSize="12" Foreground="#808080" Margin="8,0,0,12" TextWrapping="Wrap">
