<Window x:Class="EvenniaAtlas.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Evennia Atlas" Width="420" Height="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        Background="#232326" WindowStyle="ToolWindow">
    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Border Background="#4CAF50" Width="4" CornerRadius="1"
                    VerticalAlignment="Stretch" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="EVENNIA ATLAS" FontSize="18" FontWeight="SemiBold"
                           Foreground="#E0E0E0"/>
                <TextBlock Text="Visual World and Map Editor for Evennia"
                           FontSize="11" Foreground="#808080" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Separator Background="#3E3E42" Height="1" Margin="0,16,0,16"/>

        <TextBlock Text="Developed by" FontSize="11" Foreground="#808080"/>
        <TextBlock Text="Josh Rundle (dirtysouthjosh)" FontSize="13"
                   Foreground="#D0D0D0" FontWeight="SemiBold" Margin="0,2,0,0"/>

        <TextBlock Margin="0,10,0,0">
            <Hyperlink NavigateUri="https://twitch.tv/dirtysouthjosh"
                       RequestNavigate="Hyperlink_RequestNavigate"
                       Foreground="#4CAF50" TextDecorations="None">
                <TextBlock Text="twitch.tv/dirtysouthjosh" FontSize="12"/>
            </Hyperlink>
        </TextBlock>

        <Separator Background="#3E3E42" Height="1" Margin="0,16,0,16"/>

        <TextBlock Text="License" FontSize="11" Foreground="#808080"/>
        <TextBlock Text="Creative Commons Attribution-NonCommercial 4.0"
                   FontSize="11" Foreground="#B0B0B0" Margin="0,2,0,0"/>
        <TextBlock Text="Free to use, share, and modify for non-commercial purposes."
                   FontSize="10" Foreground="#808080" Margin="0,4,0,0"
                   TextWrapping="Wrap"/>
        <TextBlock Text="Commercial use is not permitted without permission."
                   FontSize="10" Foreground="#808080" Margin="0,2,0,0"
                   TextWrapping="Wrap"/>

        <TextBlock Margin="0,4,0,0">
            <Hyperlink NavigateUri="https://creativecommons.org/licenses/by-nc/4.0/"
                       RequestNavigate="Hyperlink_RequestNavigate"
                       Foreground="#808080" TextDecorations="None">
                <TextBlock Text="creativecommons.org/licenses/by-nc/4.0/" FontSize="10"/>
            </Hyperlink>
        </TextBlock>

        <Button Content="Close" Width="80" Height="28" Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Background="#3E3E42" Foreground="#CCC"
                BorderBrush="Transparent"
                Click="Close_Click" IsCancel="True"/>
    </StackPanel>
</Window>
