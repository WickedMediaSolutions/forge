<Window x:Class="EvenniaAtlas.Dialogs.RoomPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Target Room" Width="350" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#2D2D2D">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Choose destination room:" FontSize="14" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,10"/>
        <ListBox x:Name="RoomList" Grid.Row="1"
                 Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                 SelectionChanged="RoomList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3">
                        <TextBlock FontWeight="Bold" FontSize="12" Foreground="#DDD">
                            <Run Text="{Binding Title}"/>
                            <Run Text="  " Foreground="#666"/>
                            <Run Text="{Binding Id}" Foreground="#888" FontSize="10"/>
                        </TextBlock>
                        <TextBlock Text="{Binding RoomType}" Foreground="#999" FontSize="10"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,10,0"
                    Background="#555" Foreground="White" Click="Cancel_Click"/>
            <Button x:Name="OkBtn" Content="Connect" Width="80" Height="28"
                    Background="#007ACC" Foreground="White" Click="Ok_Click"
                    IsDefault="True" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>