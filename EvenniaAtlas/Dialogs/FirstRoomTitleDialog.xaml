<Window x:Class="EvenniaAtlas.Dialogs.FirstRoomTitleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Default Room Title" Width="420" Height="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#232326" WindowStyle="ToolWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Set Default Room Title" FontSize="15" FontWeight="SemiBold"
                   Foreground="#E0E0E0" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="This title will be used for all new rooms on this map."
                   Foreground="#888" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>
        <TextBox Grid.Row="2" x:Name="TitleBox" Text="Room"
                 Background="#2D2D30" Foreground="#E0E0E0" BorderBrush="#3E3E42"
                 Padding="8,6" FontSize="13" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,10,0"
                    Background="#3E3E42" Foreground="#CCC" Click="Cancel_Click"/>
            <Button Content="Create" Width="80" Height="28"
                    Background="#0E639C" Foreground="White" Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>