<Window x:Class="EvenniaAtlas.Dialogs.ValidationResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        Title="Validation Results" Height="500" Width="750"
        MinHeight="350" MinWidth="600"
        Background="#1E1E1E" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <converters:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#3E3E42" BorderThickness="0,0,0,1"
                Padding="12,10" Background="#252526">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E0E0E0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0">
            <ItemsControl x:Name="IssuesList" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#3E3E42" BorderThickness="1"
                                Padding="8,6" Margin="0,0,0,3" CornerRadius="2"
                                Background="#2D2D30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SeverityLabel}"
                                           FontWeight="Bold" FontSize="11" Width="60"
                                           Foreground="#FF6666" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Code}"
                                           FontFamily="Consolas" FontSize="10"
                                           Foreground="#808080" Width="45"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="#D0D0D0" FontSize="11"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LocationLabel}"
                                               Foreground="#808080" FontSize="10"
                                               Margin="0,2,0,0"
                                               Visibility="{Binding LocationLabel, Converter={StaticResource NonEmptyToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#252526"
                BorderBrush="#3E3E42" BorderThickness="0,1,0,0"
                Padding="8,6">
            <Button Content="Close" Click="Close_Click" Width="70"
                    HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>