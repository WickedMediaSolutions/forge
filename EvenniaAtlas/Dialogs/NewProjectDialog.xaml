<Window x:Class="EvenniaAtlas.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Project" Width="400" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" TextOptions.TextFormattingMode="Display"
        Background="#2D2D2D">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create New Map Project" FontSize="16" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Area Name:" Foreground="#CCCCCC" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" x:Name="AreaNameBox" Text="Silvermere"
                 Background="#3C3C3C" Foreground="White" BorderBrush="#555555"
                 Padding="6" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Area ID:" Foreground="#CCCCCC" Margin="0,0,0,4"/>
        <TextBox Grid.Row="4" x:Name="AreaIdBox" Text="silvermere"
                 Background="#3C3C3C" Foreground="White" BorderBrush="#555555"
                 Padding="6" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,10,0"
                    Background="#555555" Foreground="White" BorderBrush="#666666"
                    Click="Cancel_Click"/>
            <Button Content="Create" Width="80" Height="28"
                    Background="#007ACC" Foreground="White" BorderBrush="#007ACC"
                    Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
