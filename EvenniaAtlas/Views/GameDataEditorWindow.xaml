<Window x:Class="EvenniaAtlas.Views.GameDataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        Title="Game Data Editor" Height="550" Width="800"
        MinHeight="400" MinWidth="600"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Background="#2D2D30" BorderBrush="#3E3E42">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#C0C0C0"/>
                    <Setter Property="BorderBrush" Value="#3E3E42"/>
                    <Setter Property="Padding" Value="12,4"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter Content="{TemplateBinding Header}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#3E3E42"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Damage Types"/>
            <TabItem Header="Factions"/>
            <TabItem Header="Professions"/>
            <TabItem Header="Species"/>
            <TabItem Header="Alignments"/>
        </TabControl>
<!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0" Background="#252526"
                    BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0" Padding="8,8,8,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Search" Foreground="#808080" FontSize="11"
                                       Margin="0,0,0,2"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Id, Name, or Description"/>
                        </Grid>
                    </Border>

                    <!-- Entry List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ActiveFiltered}"
                             SelectedItem="{Binding ActiveSelectedEntry, Mode=TwoWay}"
                             Background="#2D2D2D" Foreground="#E0E0E0"
                             BorderThickness="0" Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="#E0E0E0"/>
                                        <TextBlock Text="{Binding Id}" FontSize="10"
                                                   Foreground="#888888"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                Margin="8,4" HorizontalAlignment="Center">
                        <Button Content="+ New" Width="60" Height="26"
                                Command="{Binding AddEntryCommand}"
                                Background="#2D2D30" Foreground="#C0C0C0"
                                BorderBrush="#555555" BorderThickness="1"
                                FontSize="11" Padding="0"
                                ToolTip="Add new entry"/>
                        <Button Content="&#x2212; Delete" Width="60" Height="26"
                                Margin="6,0,0,0"
                                Command="{Binding DeleteEntryCommand}"
                                Background="#2D2D30" Foreground="#C0C0C0"
                                BorderBrush="#555555" BorderThickness="1"
                                FontSize="11" Padding="0"
                                ToolTip="Delete selected entry"/>
                    </StackPanel>
                </Grid>
            </Border>
<!-- SEPARATOR -->
            <GridSplitter Grid.Column="1" Width="4"
                          Background="#3E3E42" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- RIGHT PANEL: Editor -->
            <Border Grid.Column="2" Background="#1E1E1E" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding ActiveSelectedEntry, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="EDIT ENTRY" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,0,0,12"/>

                        <TextBlock Text="Id" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ActiveSelectedEntry.Id, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Name" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ActiveSelectedEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Description" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <TextBox Text="{Binding ActiveSelectedEntry.Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="80" Height="120"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>