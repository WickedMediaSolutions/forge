                                     SelectedItem="{Binding SelectedMetadataAttribute, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A40"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" BorderBrush="#3E3E42"
                                                BorderThickness="0,0,0,1" Padding="2,2,2,4">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Key" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                        <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Value" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Category" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="LockString" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                        <TextBox Text="{Binding LockString, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="2"
                                                Background="#1E1E1E">
                                            <ItemsPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>

                            <!-- PERMISSIONS -->
                            <Grid Margin="0,8,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PERMISSIONS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#C0C0C0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataPermissionCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Permission"/>
                                    <Button Content="−" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataPermissionCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Permission"/>
                                </StackPanel>
                            </Grid>
                            <ListBox ItemsSource="{Binding SelectedItem.Metadata.Permissions}"
                                     SelectedItem="{Binding SelectedMetadataPermission, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A40"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" BorderBrush="#3E3E42"
                                                BorderThickness="0,0,0,1" Padding="2,2,2,4">
                                            <TextBox Text="{Binding ., UpdateSourceTrigger=PropertyChanged}"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="2"
                                                Background="#1E1E1E">
                                            <ItemsPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>

                            <!-- LockString -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="LOCK STRING" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedItem.Metadata.LockString, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="48" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </StackPanel>

                    <Border Margin="0,12,0,0"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource NonEmptyToVis}}">
                        <Border Background="#553333" BorderBrush="#994444"
                                BorderThickness="1" CornerRadius="2"
                                Padding="8,6">
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="#FFAAAA" FontSize="11"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
