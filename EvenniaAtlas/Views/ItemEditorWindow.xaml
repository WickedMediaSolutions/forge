<Window x:Class="EvenniaAtlas.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        xmlns:models="clr-namespace:EvenniaAtlas.Models"
        Title="Item Editor" Height="650" Width="1000"
        MinHeight="450" MinWidth="800"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <converters:ItemTypeFilterDisplayConverter x:Key="TypeFilterDisplay"/>

        <converters:ItemTypeToVisibilityConverter x:Key="ItemTypeToVis"/>

        <ObjectDataProvider x:Key="ItemTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type models:ItemType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ItemType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EquipmentSlotValues" MethodName="GetValues"
                            ObjectType="{x:Type models:EquipmentSlot}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:EquipmentSlot"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WeaponTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type models:WeaponType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:WeaponType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ArmorTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type models:ArmorType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ArmorType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="RequirementTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type models:RequirementType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:RequirementType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ComparisonOperatorValues" MethodName="GetValues"
                            ObjectType="{x:Type models:ComparisonOperator}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ComparisonOperator"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="ModifierValueTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type models:ModifierValueType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ModifierValueType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EffectTriggerValues" MethodName="GetValues"
                            ObjectType="{x:Type models:ItemEffectTrigger}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ItemEffectTrigger"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="SourceTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type models:ItemSourceType}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ItemSourceType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Item Editor ComboBox visual fix: black text for readability -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="#252526"
                BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0" Padding="8,8,8,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Search" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by key, description, or notes"/>
                    </Grid>
                </Border>

                <!-- Type Filter -->
                <Border Grid.Row="1" Padding="8,4,8,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Type Filter" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <ComboBox Grid.Row="1"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  SelectedValue="{Binding SelectedTypeFilter}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TypeFilterDisplay}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Item List -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding FilteredItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderBrush="#3E3E42" BorderThickness="0,1,0,1"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Key}"
                                           Foreground="#E0E0E0" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ItemType}"
                                           Foreground="#808080" FontSize="10"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Command Buttons -->
                <Border Grid.Row="3" Padding="8,6,8,8">
                    <StackPanel>
                        <Button Content="New" Command="{Binding NewItemCommand}"
                                Margin="0,0,0,4"/>
                        <Button Content="Duplicate"
                                Command="{Binding DuplicateItemCommand}"
                                IsEnabled="{Binding HasSelectedItem}"
                                Margin="0,0,0,4"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteItemCommand}"
                                IsEnabled="{Binding HasSelectedItem}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="3"
                      Background="#3E3E42"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"/>

        <!-- RIGHT PANEL -->
        <Border Grid.Column="2" Background="#1E1E1E">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12">

                    <!-- EMPTY SELECTION -->
                    <TextBlock Text="Select an item to edit."
                               Foreground="#808080" FontSize="14"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                    <!-- EDITOR (visible when item selected) -->
                    <StackPanel Visibility="{Binding HasSelectedItem, Converter={StaticResource BoolToVis}}">

                        <!-- GENERAL SECTION -->
                        <TextBlock Text="GENERAL" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,0,0,8"/>

                        <!-- IDENTITY -->
                        <TextBlock Text="IDENTITY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,8,0,4"/>

                        <TextBlock Text="Id" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedItem.Id}"
                                 IsReadOnly="True"
                                 Background="#333333" Foreground="#888888"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Key" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedItem.Key, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="ItemType" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ItemTypeCombo"
                                  ItemsSource="{Binding Source={StaticResource ItemTypeValues}}"
                                  SelectedItem="{Binding SelectedItem.ItemType}"
                                  SelectionChanged="ItemTypeCombo_SelectionChanged"
                                  Margin="0,0,0,6"/>

                        <TextBlock Text="EquipmentSlot" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding Source={StaticResource EquipmentSlotValues}}"
                                  SelectedItem="{Binding SelectedItem.EquipmentSlot}"
                                  Margin="0,0,0,6"/>

                        <!-- DESCRIPTION -->
                        <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <TextBlock Text="Description" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedItem.Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="60" Height="80" Margin="0,0,0,6"/>

                        <TextBlock Text="Notes" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedItem.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="60" Height="80" Margin="0,0,0,6"/>

                        <!-- REQUIREMENTS / BASIC VALUES -->
                        <TextBlock Text="REQUIREMENTS / BASIC VALUES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Level Requirement" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedItem.LevelRequirement, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Encumbrance" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedItem.Encumbrance, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                <TextBlock Text="Item Limit" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedItem.ItemLimit, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                                <TextBlock Text="Base Value" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedItem.BaseValue, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
                                <TextBlock Text="Magic Level" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedItem.MagicLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- FLAGS -->
                        <TextBlock Text="FLAGS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <CheckBox Content="Gettable"
                                      IsChecked="{Binding SelectedItem.IsGettable}"
                                      Grid.Row="0" Grid.Column="0" Margin="0,1"/>
                            <CheckBox Content="Droppable"
                                      IsChecked="{Binding SelectedItem.IsDroppable}"
                                      Grid.Row="0" Grid.Column="1" Margin="0,1"/>
                            <CheckBox Content="Sellable"
                                      IsChecked="{Binding SelectedItem.IsSellable}"
                                      Grid.Row="1" Grid.Column="0" Margin="0,1"/>
                            <CheckBox Content="Tradeable"
                                      IsChecked="{Binding SelectedItem.IsTradeable}"
                                      Grid.Row="1" Grid.Column="1" Margin="0,1"/>
                            <CheckBox Content="Unique"
                                      IsChecked="{Binding SelectedItem.IsUnique}"
                                      Grid.Row="2" Grid.Column="0" Margin="0,1"/>
                            <CheckBox Content="Quest Item"
                                      IsChecked="{Binding SelectedItem.IsQuestItem}"
                                      Grid.Row="2" Grid.Column="1" Margin="0,1"/>
                            <CheckBox Content="Magical"
                                      IsChecked="{Binding SelectedItem.IsMagical}"
                                      Grid.Row="3" Grid.Column="0" Margin="0,1"/>
                        </Grid>

                        <!-- WEAPON SECTION -->
                        <StackPanel Visibility="{Binding SelectedItem.ItemType, Converter={StaticResource ItemTypeToVis}, ConverterParameter=Weapon}">
                            <TextBlock Text="WEAPON" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E0E0E0" Margin="0,12,0,8"/>

                            <TextBlock Text="WeaponType" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource WeaponTypeValues}}"
                                      SelectedItem="{Binding SelectedItem.WeaponData.WeaponType}"
                                      Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Damage Min" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.DamageMin, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Damage Max" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.DamageMax, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                    <TextBlock Text="Strength Requirement" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.StrengthRequirement, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,6,0,0">
                                    <TextBlock Text="Speed" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.Speed, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
                                    <TextBlock Text="Accuracy Modifier" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.AccuracyModifier, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,6,0,0">
                                    <TextBlock Text="Backstab Accuracy" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.BackstabAccuracyModifier, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,6,0,0">
                                    <TextBlock Text="Range" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.Range, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,6,0,0">
                                    <TextBlock Text="Hands Required" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.WeaponData.HandsRequired, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ARMOR / SHIELD SECTION -->
                        <StackPanel Visibility="{Binding SelectedItem.ItemType, Converter={StaticResource ItemTypeToVis}, ConverterParameter='Armor,Shield'}">
                            <TextBlock Text="ARMOR" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E0E0E0" Margin="0,12,0,8"/>

                            <TextBlock Text="ArmorType" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource ArmorTypeValues}}"
                                      SelectedItem="{Binding SelectedItem.ArmorData.ArmorType}"
                                      Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Armor Class" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.ArmorData.ArmorClass, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Damage Reduction" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.ArmorData.DamageReduction, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                                    <TextBlock Text="Accuracy Modifier" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding SelectedItem.ArmorData.AccuracyModifier, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

<!-- REQUIREMENTS SECTION -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="REQUIREMENTS" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddRequirementCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Requirement"/>
                                    <Button Content="−" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveRequirementCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Requirement"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedItem.Requirements}"
                                     SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A40"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" BorderBrush="#3E3E42"
                                                BorderThickness="0,0,0,1" Padding="2,2,2,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Type" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource RequirementTypeValues}}"
                                                              SelectedItem="{Binding RequirementType}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Operator" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                    <ComboBox ItemsSource="{Binding Source={StaticResource ComparisonOperatorValues}}"
                                                              SelectedItem="{Binding Operator}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Value" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="2"
                                                Background="#1E1E1E">
                                            <ItemsPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ListBox.Template>
                            </ListBox>
                        </StackPanel>
<!-- MODIFIERS SECTION -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="MODIFIERS" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E0E0E0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddModifierCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Modifier"/>
                                    <Button Content="−" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveModifierCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Modifier"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedItem.Modifiers}"
                                     SelectedItem="{Binding SelectedModifier, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3A3A40"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" BorderBrush="#3E3E42"
                                                BorderThickness="0,0,0,1" Padding="2,2,2,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="6"/>
