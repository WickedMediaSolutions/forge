<Window x:Class="EvenniaAtlas.Views.ShopEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        Title="Shop Editor" Height="650" Width="900"
        MinHeight="450" MinWidth="700"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="#252526"
                BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0" Padding="8,8,8,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Search" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by key, description, or notes"/>
                    </Grid>
                </Border>

                <!-- Shop List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredShops}"
                         SelectedItem="{Binding SelectedShop}"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderThickness="0" Margin="4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Key}" FontSize="13"
                                               Foreground="#E0E0E0"/>
                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                               Foreground="#888888"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            Margin="8,4" HorizontalAlignment="Center">
                    <Button Content="+ New" Width="60" Height="26"
                            Command="{Binding NewShopCommand}"
                            Background="#2D2D30" Foreground="#C0C0C0"
                            BorderBrush="#555555" BorderThickness="1"
                            FontSize="11" Padding="0"
                            ToolTip="Create new shop"/>
                    <Button Content="Clone" Width="50" Height="26" Margin="4,0,0,0"
                            Command="{Binding DuplicateShopCommand}"
                            Background="#2D2D30" Foreground="#C0C0C0"
                            BorderBrush="#555555" BorderThickness="1"
                            FontSize="11" Padding="0"
                            ToolTip="Duplicate selected shop"/>
                    <Button Content="Delete" Width="50" Height="26" Margin="4,0,0,0"
                            Command="{Binding DeleteShopCommand}"
                            Background="#2D2D30" Foreground="#C0C0C0"
                            BorderBrush="#555555" BorderThickness="1"
                            FontSize="11" Padding="0"
                            ToolTip="Delete selected shop"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="3"
                      Background="#3E3E42"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"/>
<!-- RIGHT PANEL -->
        <Border Grid.Column="2" Background="#1E1E1E">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12">

                    <!-- VALIDATION -->
                    <Border Background="#3D2020" Padding="8,4" CornerRadius="3"
                            Margin="0,0,0,8"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource NonEmptyToVis}}">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="#FF6B6B" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- EMPTY SELECTION -->
                    <TextBlock Text="Select a shop to edit."
                               Foreground="#808080" FontSize="14"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedShop, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                    <!-- EDITOR CONTENT -->
                    <StackPanel Visibility="{Binding HasSelectedShop, Converter={StaticResource BoolToVis}}">

                        <!-- GENERAL SECTION -->
                        <TextBlock Text="GENERAL" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,0,0,8"/>

                        <TextBlock Text="Id" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedShop.Id}"
                                 IsReadOnly="True"
                                 Background="#333333" Foreground="#888888"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Key" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedShop.Key, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Description" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedShop.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6" AcceptsReturn="True" MinHeight="60"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="Notes" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedShop.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6" AcceptsReturn="True" MinHeight="60"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<!-- OWNER SECTION -->
                        <TextBlock Text="OWNER" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <TextBlock Text="Owner NPC" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableNpcs}"
                                      DisplayMemberPath="Key"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedShop.NpcId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Clear" Width="50" Height="22"
                                    Background="#2D2D30" Foreground="#C0C0C0"
                                    BorderBrush="#555555" BorderThickness="1"
                                    FontSize="11" Padding="0"
                                    ToolTip="Clear owner assignment"
                                    Click="ClearOwner_Click"/>
                        </Grid>
<!-- INVENTORY -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="INVENTORY" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddInventoryEntryCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Inventory Entry"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveInventoryEntryCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Inventory Entry"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding InventoryEntries}"
                                     SelectedItem="{Binding SelectedInventoryEntry, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2" Padding="4,3"
                                                Background="#252526" CornerRadius="2">
                                            <StackPanel>
                                                <!-- Item + Quantity -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Key"
                                                              SelectedValue="{Binding ItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,0,4,0"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <!-- Unlimited + Enabled -->
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" Content="Unlimited"
                                                              IsChecked="{Binding IsUnlimited}"
                                                              Foreground="#C0C0C0" FontSize="11"
                                                              VerticalAlignment="Center"
                                                              ToolTip="When checked, Quantity is ignored"/>
                                                    <CheckBox Grid.Column="1" Content="Enabled"
                                                              IsChecked="{Binding IsEnabled}"
                                                              Foreground="#C0C0C0" FontSize="11"
                                                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>
                                                <!-- Prices -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                        <TextBlock Text="Buy Price" Foreground="#808080" FontSize="10" Margin="0,0,0,1"
                                                                   ToolTip="Price the player pays to buy from the shop"/>
                                                        <TextBox Text="{Binding BuyPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Sell Price" Foreground="#808080" FontSize="10" Margin="0,0,0,1"
                                                                   ToolTip="Price the shop pays to buy from the player"/>
                                                        <TextBox Text="{Binding SellPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- EVENNIA METADATA -->
                        <TextBlock Text="EVENNIA METADATA" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <TextBlock Text="Typeclass Path" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedShop.Metadata.TypeclassPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Lock String" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedShop.Metadata.LockString, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>
<!-- ALIASES -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ALIASES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataAliasCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Alias"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataAliasCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Alias"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedShop.Metadata.Aliases}"
                                     SelectedItem="{Binding SelectedMetadataAlias, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,4,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- TAGS -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TAGS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataTagCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Tag"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataTagCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Tag"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedShop.Metadata.Tags}"
                                     SelectedItem="{Binding SelectedMetadataTag, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- ATTRIBUTES -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ATTRIBUTES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataAttributeCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Attribute"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataAttributeCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Attribute"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedShop.Metadata.Attributes}"
                                     SelectedItem="{Binding SelectedMetadataAttribute, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding LockString, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- PERMISSIONS -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PERMISSIONS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataPermissionCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Permission"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataPermissionCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Permission"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedShop.Metadata.Permissions}"
                                     SelectedItem="{Binding SelectedMetadataPermission, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ., UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>