<Window x:Class="EvenniaAtlas.Views.NpcEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        xmlns:models="clr-namespace:EvenniaAtlas.Models"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="NPC Editor" Height="650" Width="900"
        MinHeight="450" MinWidth="700"
        Background="#1E1E1E" FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>

        <ObjectDataProvider x:Key="NpcAggressionModes"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:NpcAggressionMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EquipmentSlots"
                            MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:EquipmentSlot"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <Border Grid.Column="0" Background="#252526"
                BorderBrush="#3E3E42" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Border Grid.Row="0" Padding="8,8,8,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Search" Foreground="#808080" FontSize="11"
                                   Margin="0,0,0,2"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search by key, description, or notes"/>
                    </Grid>
                </Border>

                <!-- NPC List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding FilteredNpcs}"
                         SelectedItem="{Binding SelectedNpc}"
                         Background="#2D2D2D" Foreground="#E0E0E0"
                         BorderThickness="0" Margin="4,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Key}" FontSize="13"
                                               Foreground="#E0E0E0"/>
                                    <TextBlock Text="{Binding Id}" FontSize="10"
                                               Foreground="#888888"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            Margin="8,4" HorizontalAlignment="Center">
                    <Button Content="+ New" Width="60" Height="26"
                            Command="{Binding NewNpcCommand}"
                            Background="#2D2D30" Foreground="#C0C0C0"
                            BorderBrush="#555555" BorderThickness="1"
                            FontSize="11" Padding="0"
                            ToolTip="Create new NPC"/>
                    <Button Content="Clone" Width="50" Height="26" Margin="4,0,0,0"
                            Command="{Binding DuplicateNpcCommand}"
                            Background="#2D2D30" Foreground="#C0C0C0"
                            BorderBrush="#555555" BorderThickness="1"
                            FontSize="11" Padding="0"
                            ToolTip="Duplicate selected NPC"/>
                    <Button Content="Delete" Width="50" Height="26" Margin="4,0,0,0"
                            Command="{Binding DeleteNpcCommand}"
                            Background="#2D2D30" Foreground="#C0C0C0"
                            BorderBrush="#555555" BorderThickness="1"
                            FontSize="11" Padding="0"
                            ToolTip="Delete selected NPC"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Column="1" Width="3"
                      Background="#3E3E42"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"/>
<!-- RIGHT PANEL -->
        <Border Grid.Column="2" Background="#1E1E1E">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12">

                    <!-- VALIDATION -->
                    <Border Background="#3D2020" Padding="8,4" CornerRadius="3"
                            Margin="0,0,0,8"
                            Visibility="{Binding ValidationMessage, Converter={StaticResource NonEmptyToVis}}">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="#FF6B6B" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- EMPTY SELECTION -->
                    <TextBlock Text="Select an NPC to edit."
                               Foreground="#808080" FontSize="14"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedNpc, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                    <!-- EDITOR (visible when NPC selected) -->
                    <StackPanel Visibility="{Binding HasSelectedNpc, Converter={StaticResource BoolToVis}}">

                        <!-- GENERAL SECTION -->
                        <TextBlock Text="GENERAL" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,0,0,8"/>

                        <!-- IDENTITY -->
                        <TextBlock Text="IDENTITY" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,8,0,4"/>

                        <TextBlock Text="Id" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedNpc.Id}"
                                 IsReadOnly="True"
                                 Background="#333333" Foreground="#888888"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Key" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedNpc.Key, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <!-- DESCRIPTION -->
                        <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <TextBlock Text="Description" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedNpc.Description, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="60" Height="80" Margin="0,0,0,6"/>

                        <TextBlock Text="Notes" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedNpc.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="60" Height="80" Margin="0,0,0,6"/>

<!-- CLASSIFICATION -->
                        <TextBlock Text="CLASSIFICATION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Species" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableSpecies}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedNpc.Classification.Species, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Profession" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableProfessions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedNpc.Classification.Profession, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                <TextBlock Text="Faction" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableFactions}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedNpc.Classification.Faction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Alignment" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableAlignments}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedNpc.Classification.Alignment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"/>
                            </StackPanel>
                        </Grid>
<!-- LOOT -->
                        <TextBlock Text="LOOT" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <TextBlock Text="Loot Table" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableLootTables}"
                                      DisplayMemberPath="Key"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedNpc.LootTableId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Clear" Width="50" Height="22"
                                    Command="{Binding ClearLootTableCommand}"
                                    Background="#2D2D30" Foreground="#C0C0C0"
                                    BorderBrush="#555555" BorderThickness="1"
                                    FontSize="11" Padding="0"
                                    ToolTip="Clear loot table assignment"/>
                        </Grid>
<!-- DIALOGUE -->
                        <TextBlock Text="DIALOGUE" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#A0A0A0" Margin="0,12,0,4"/>

                        <TextBlock Text="Dialogue" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableDialogues}"
                                      DisplayMemberPath="Key"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedNpc.DialogueId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Content="Clear" Width="50" Height="22"
                                    Command="{Binding ClearDialogueCommand}"
                                    Background="#2D2D30" Foreground="#C0C0C0"
                                    BorderBrush="#555555" BorderThickness="1"
                                    FontSize="11" Padding="0"
                                    ToolTip="Clear dialogue assignment"/>
                        </Grid>
<!-- STATS SECTION -->
                        <TextBlock Text="STATS" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <!-- Row 1 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Level" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.Level, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Max Health" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.MaxHealth, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                <TextBlock Text="Max Mana" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.MaxMana, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Max Stamina" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.MaxStamina, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Strength" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.Strength, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Agility" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.Agility, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                <TextBlock Text="Intellect" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.Intellect, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,4,0">
                                <TextBlock Text="Wisdom" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.Wisdom, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Charm" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.Charm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Experience Reward" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.ExperienceReward, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Currency Reward" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Stats.CurrencyReward, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- COMBAT SECTION -->
                        <TextBlock Text="COMBAT" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <!-- Combat Row 1 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Minimum Damage" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Combat.DamageMin, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Maximum Damage" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Combat.DamageMax, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,4,0">
                                <TextBlock Text="Accuracy Modifier" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Combat.AccuracyModifier, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Attack Speed" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Combat.AttackSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Combat Row 2 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Armor Class" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Combat.ArmorClass, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Damage Reduction" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Combat.DamageReduction, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- BEHAVIOR SECTION -->
                        <TextBlock Text="BEHAVIOR" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <!-- Behavior Row 1 - Aggression -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Aggression Mode" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource NpcAggressionModes}}"
                                          SelectedItem="{Binding SelectedNpc.Behavior.AggressionMode, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Aggro Range" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Behavior.AggroRange, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Behavior Row 2 - Wandering -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Can Wander" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <CheckBox IsChecked="{Binding SelectedNpc.Behavior.CanWander, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Wander Interval Seconds" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Behavior.WanderIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Behavior Row 3 - Fleeing -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Can Flee" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <CheckBox IsChecked="{Binding SelectedNpc.Behavior.CanFlee, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Flee Health %" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedNpc.Behavior.FleeHealthPercent, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <!-- PATROL SECTION -->
                        <TextBlock Text="PATROL" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <!-- Patrol Settings -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Enabled" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <CheckBox IsChecked="{Binding SelectedNpc.Patrol.Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Loop" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <CheckBox IsChecked="{Binding SelectedNpc.Patrol.Loop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="#E0E0E0" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Waypoints -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="WAYPOINTS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddPatrolWaypointCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Waypoint"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemovePatrolWaypointCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Waypoint"/>
                                    <Button Content="&#x25B2;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding MovePatrolWaypointUpCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="12" FontWeight="Bold" Padding="0"
                                            ToolTip="Move Up"/>
                                    <Button Content="&#x25BC;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding MovePatrolWaypointDownCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="12" FontWeight="Bold" Padding="0"
                                            ToolTip="Move Down"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding PatrolWaypointEntries}"
                                     SelectedItem="{Binding SelectedPatrolWaypoint, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding DataContext.AvailableRooms, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Title"
                                                          SelectedValue="{Binding RoomId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,4,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Wait (s)" Foreground="#808080" FontSize="10" Margin="0,0,0,1"/>
                                                    <TextBox Text="{Binding WaitSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- ABILITIES -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ABILITIES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddAbilityCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Ability"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveAbilityCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Ability"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedNpc.Abilities}"
                                     SelectedItem="{Binding SelectedAbility, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding AbilityId, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding AbilityName, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding ChancePercent, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="4" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     MinHeight="24" Height="36"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- RESISTANCES / IMMUNITIES -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RESISTANCES / IMMUNITIES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddResistanceCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Resistance"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveResistanceCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Resistance"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedNpc.Resistances}"
                                     SelectedItem="{Binding SelectedResistance, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding DataContext.AvailableDamageTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Name"
                                                          SelectedValue="{Binding DamageType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEditable="True"
                                                          Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding ResistancePercent, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,4,0"/>
                                                <CheckBox Grid.Column="2" Content="Immune"
                                                          IsChecked="{Binding IsImmune, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Foreground="#C0C0C0" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap" AcceptsReturn="True"
                                                     MinHeight="24" Height="36"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- EQUIPMENT -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EQUIPMENT" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddEquipmentCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Equipment"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveEquipmentCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Equipment"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding EquipmentEntries}"
                                     SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Key"
                                                          SelectedValue="{Binding ItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,4,0"/>
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{StaticResource EquipmentSlots}"
                                                          SelectedItem="{Binding Slot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- INVENTORY -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="INVENTORY" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddInventoryCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Inventory"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveInventoryCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Inventory"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding InventoryEntries}"
                                     SelectedItem="{Binding SelectedInventory, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Key"
                                                          SelectedValue="{Binding ItemId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <TextBlock Text="EVENNIA METADATA" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#E0E0E0" Margin="0,16,0,8"/>

                        <TextBlock Text="Typeclass Path" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedNpc.Metadata.TypeclassPath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Lock String" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedNpc.Metadata.LockString, UpdateSourceTrigger=PropertyChanged}"/>
<!-- ALIASES -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ALIASES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataAliasCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Alias"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataAliasCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Alias"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedNpc.Metadata.Aliases}"
                                     SelectedItem="{Binding SelectedMetadataAlias, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,4,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- TAGS -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TAGS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataTagCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Tag"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataTagCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Tag"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedNpc.Metadata.Tags}"
                                     SelectedItem="{Binding SelectedMetadataTag, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                                 Margin="0,0,0,6"/>
<!-- ATTRIBUTES -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ATTRIBUTES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataAttributeCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Attribute"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataAttributeCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Attribute"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedNpc.Metadata.Attributes}"
                                     SelectedItem="{Binding SelectedMetadataAttribute, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,2,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding LockString, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
<!-- PERMISSIONS -->
                        <StackPanel>
                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PERMISSIONS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="+" Width="28" Height="22"
                                            Command="{Binding AddMetadataPermissionCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Add Permission"/>
                                    <Button Content="&#x2212;" Width="28" Height="22" Margin="4,0,0,0"
                                            Command="{Binding RemoveMetadataPermissionCommand}"
                                            Background="#2D2D30" Foreground="#C0C0C0"
                                            BorderBrush="#555555" BorderThickness="1"
                                            FontSize="14" FontWeight="Bold" Padding="0"
                                            ToolTip="Remove Permission"/>
                                </StackPanel>
                            </Grid>

                            <ListBox ItemsSource="{Binding SelectedNpc.Metadata.Permissions}"
                                     SelectedItem="{Binding SelectedMetadataPermission, Mode=TwoWay}"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ., UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
