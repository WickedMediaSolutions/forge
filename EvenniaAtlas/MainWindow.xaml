<Window x:Class="EvenniaAtlas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EvenniaAtlas.Controls"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        Title="{Binding TitleBarText}" Height="750" Width="1200"
        MinHeight="500" MinWidth="900"
        Icon="Images/the-forge-logo-ico.png"
        Background="#1E1E1E" FontFamily="Segoe UI"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MASTHEAD BANNER -->
        <Image Grid.Row="0" Source="Images/the-forge-banner-100.png"
               Height="100" Stretch="Uniform"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- BRANDING -->
        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource ShellHeaderBg}" Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource EvenniaGreen}"
                            CornerRadius="1" VerticalAlignment="Stretch"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBlock Text="World &amp; Content Editor for Rites of Passage: A New Age"
                                    FontSize="10" Foreground="#808080" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

<!-- MENU BAR -->
        <Menu Grid.Row="2" Style="{StaticResource ShellMenuStyle}" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Click="New_Click" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open Project..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click"/>
               <Separator/>
                <MenuItem Header="_Export Evennia JSON..." Click="Export_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="_Redo" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="_Delete Selected" Click="Delete_Click" InputGestureText="Delete"/>
            </MenuItem>
            <MenuItem Header="_View">
               <MenuItem Header="_Fit Map" Click="Fit_Click"/>
                <MenuItem Header="_Center Selected" Click="Center_Click"/>
                <Separator/>
               <MenuItem Header="Zoom _In" Click="ZoomIn_Click"/>
               <MenuItem Header="Zoom _Out" Click="ZoomOut_Click"/>
           </MenuItem>
            <MenuItem Header="_Map">
                <MenuItem Header="_Build Mode" Click="BuildMode_Click"/>
                <MenuItem Header="_Auto Reverse" Click="AutoReverse_Click"/>
                <Separator/>
                <MenuItem Header="Floor _Up" Click="FloorUp_Click"/>
                <MenuItem Header="Floor _Down" Click="FloorDown_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Validate Map" Click="Validate_Click"/>
                <Separator/>
                <MenuItem Header="_Item Editor" Click="ItemEditor_Click"/>
                <MenuItem Header="_Npc Editor" Click="NpcEditor_Click"/>
                <MenuItem Header="_Shop Editor" Click="ShopEditor_Click"/>
                <MenuItem Header="_Loot Table Editor" Click="LootTableEditor_Click"/>
                <MenuItem Header="_Quest Editor" Click="QuestEditor_Click"/>
                <MenuItem Header="_Dialogue Editor" Click="DialogueEditor_Click"/>
                <MenuItem Header="_Game Data" Click="GameDataEditor_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_How to Use" Click="HelpHowToUse_Click"/>
                <MenuItem Header="_GitHub Repository" Click="HelpGitHub_Click"/>
                <Separator Style="{StaticResource ShellMenuSeparatorStyle}"/>
                <MenuItem Header="_About Rites of Passage: The Forge" Click="HelpAbout_Click"/>
            </MenuItem>
        </Menu>
<!-- TOOLBAR -->
        <Border Grid.Row="3" Background="{StaticResource ShellToolbarBg}" Padding="4,2"
                BorderBrush="{StaticResource ShellToolbarBorder}" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BuildBtn" Click="BuildMode_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{Binding BuildModeText}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,4,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource LedOffGray}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BuildMode}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource LedOnGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="BUILD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button x:Name="AutoRevBtn" Click="AutoReverse_Click"
                        Style="{StaticResource ToolbarButtonStyle}"
                        ToolTip="{Binding AutoReverseText}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,4,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource LedOffGray}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AutoReverse}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource LedOnGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="AUTO REVERSE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Content="▼" Style="{StaticResource ToolbarButtonStyle}" Click="FloorDown_Click"
                        FontSize="8" Padding="5,2" ToolTip="Floor Down"/>
                <TextBlock Text="{Binding FloorLabel}" Foreground="#D0D0D0" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="2,0" FontSize="11" MinWidth="28"
                           TextAlignment="Center"/>
                <Button Content="▲" Style="{StaticResource ToolbarButtonStyle}" Click="FloorUp_Click"
                        FontSize="8" Padding="5,2" ToolTip="Floor Up"/>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Content="Fit" Style="{StaticResource ToolbarButtonStyle}" Click="Fit_Click"
                        ToolTip="Fit all rooms on this floor into view"/>
                <Button Content="Center" Style="{StaticResource ToolbarButtonStyle}" Click="Center_Click"
                        ToolTip="Center on selected room"/>
                <Rectangle Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Content="−" Style="{StaticResource ToolbarButtonStyle}" Click="ZoomOut_Click"
                        FontSize="12" FontWeight="Bold" Padding="5,2"
                        ToolTip="Zoom Out (Ctrl+MouseWheel Down)"/>
                <TextBlock Text="{Binding ZoomPercentage}" Foreground="#D0D0D0"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="2,0" FontSize="11" MinWidth="32"
                           TextAlignment="Center"/>
                <Button Content="+" Style="{StaticResource ToolbarButtonStyle}" Click="ZoomIn_Click"
                        FontSize="12" FontWeight="Bold" Padding="5,2"
                        ToolTip="Zoom In (Ctrl+MouseWheel Up)"/>
            </StackPanel>
        </Border>
        <!-- MAIN -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <controls:MapCanvas x:Name="MapCanvasControl" Grid.Column="0" DataContext="{Binding}"/>
            <GridSplitter Grid.Column="1" Width="3" Background="#474747"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#252526">
                <StackPanel Margin="10">

                    <StackPanel Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ROOM" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                        <TextBlock Text="ID" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedRoom.Id}" Foreground="#B0B0B0" Background="#333337" Padding="5,3" Margin="0,0,0,6"/>
                        <TextBlock Text="Title" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Type" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Description" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,3,0"><TextBlock Text="X" Foreground="#808080" FontSize="11"/><TextBlock Text="{Binding SelectedRoomX}" Foreground="#CCA700" FontWeight="SemiBold" Background="#333337" Padding="5,3"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,3,0"><TextBlock Text="Y" Foreground="#808080" FontSize="11"/><TextBlock Text="{Binding SelectedRoomY}" Foreground="#CCA700" FontWeight="SemiBold" Background="#333337" Padding="5,3"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Z" Foreground="#808080" FontSize="11"/><TextBlock Text="{Binding SelectedRoomZ}" Foreground="#CCA700" FontWeight="SemiBold" Background="#333337" Padding="5,3"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Tags" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Notes" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Margin="0,0,0,6"/>
<!-- ITEM SPAWNS -->
                        <TextBlock Text="ITEM SPAWNS" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Add Item Spawn" Command="{Binding AddItemSpawnCommand}" Margin="0,0,4,0"/>
                            <Button Content="Remove" Command="{Binding RemoveItemSpawnCommand}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SelectedRoomItemSpawns}"
                                 SelectedItem="{Binding SelectedItemSpawn, Mode=TwoWay}"
                                 Background="#2D2D2D" BorderBrush="#3E3E42"
                                 Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ComboBox Grid.Row="0"
                                                  ItemsSource="{Binding DataContext.AvailableItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Key"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding EntityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,3"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="Qty" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,6,0"/>
                                            <TextBlock Text="Respawn (s)" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBox Text="{Binding RespawnSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,6,0"/>
                                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Foreground="#D0D0D0" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- MONSTER / NPC SPAWNS -->
                        <TextBlock Text="MONSTER / NPC SPAWNS" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Add Monster/NPC Spawn" Command="{Binding AddNpcSpawnCommand}" Margin="0,0,4,0"/>
                            <Button Content="Remove" Command="{Binding RemoveNpcSpawnCommand}"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SelectedRoomNpcSpawns}"
                                 SelectedItem="{Binding SelectedNpcSpawn, Mode=TwoWay}"
                                 Background="#2D2D2D" BorderBrush="#3E3E42">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ComboBox Grid.Row="0"
                                                  ItemsSource="{Binding DataContext.AvailableNpcs, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="Key"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding EntityId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,3"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="Qty" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,6,0"/>
                                            <TextBlock Text="Respawn (s)" Foreground="#808080" FontSize="11" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <TextBox Text="{Binding RespawnSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,6,0"/>
                                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Foreground="#D0D0D0" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
<!-- EVENNIA -->
                        <Expander Header="EVENNIA" IsExpanded="False"
                                  Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold"
                                  Background="#2D2D2D" BorderBrush="#3E3E42"
                                  Margin="0,8,0,0" Padding="4">
                            <StackPanel Margin="4,4,0,0">
                                <TextBlock Text="Typeclass Path" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedRoomTypeclassPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"/>

                                <TextBlock Text="Lock String" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedRoomLockString, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,8"/>

                                <!-- ALIASES -->
                                <TextBlock Text="Aliases (Key / Category)" Foreground="#808080" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Button Content="+" Click="AddRoomAlias_Click" Width="22" Height="22"
                                        FontSize="11" Padding="0" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding RoomAliases}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                <Button Grid.Column="2" Content="×" Click="RemoveRoomAlias_Click" Width="18" Height="18"
                                                        FontSize="10" Padding="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- TAGS -->
                                <TextBlock Text="Tags (Key / Category / Data)" Foreground="#808080" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Button Content="+" Click="AddRoomEvenniaTag_Click" Width="22" Height="22"
                                        FontSize="11" Padding="0" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding RoomEvenniaTags}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                <TextBox Grid.Column="2" Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                <Button Grid.Column="3" Content="×" Click="RemoveRoomEvenniaTag_Click" Width="18" Height="18"
                                                        FontSize="10" Padding="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ATTRIBUTES -->
                                <TextBlock Text="Attributes (Key / Value / Category / LockString)" Foreground="#808080" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Button Content="+" Click="AddRoomAttribute_Click" Width="22" Height="22"
                                        FontSize="11" Padding="0" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding RoomAttributes}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                    <Button Grid.Column="2" Content="×" Click="RemoveRoomAttribute_Click" Width="18" Height="18"
                                                            FontSize="10" Padding="0"/>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,2,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding LockString, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- PERMISSIONS -->
                                <TextBlock Text="Permissions" Foreground="#808080" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <Button Content="+" Click="AddRoomPermission_Click" Width="22" Height="22"
                                        FontSize="11" Padding="0" Margin="0,0,0,2"/>
                                <ItemsControl ItemsSource="{Binding RoomPermissions}" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Text="{Binding ., Mode=OneWay}" LostFocus="PermissionTextBox_LostFocus" Margin="0,0,2,0"/>
                                                <Button Grid.Column="1" Content="×" Click="RemoveRoomPermission_Click" Width="18" Height="18"
                                                        FontSize="10" Padding="0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <TextBlock Text="EXITS" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,8,0,4"/>
                        <ItemsControl ItemsSource="{Binding RoomExits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#333337" BorderBrush="#3E3E42" BorderThickness="1" Padding="5,3" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="ConnectionListItem_Click">
                                        <TextBlock FontSize="11"><Run Text="{Binding Direction}" Foreground="#CCA700" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding DestinationRoomId}" Foreground="#B0B0B0"/></TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>                    <StackPanel Visibility="{Binding IsConnectionSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="EXIT PROPERTIES" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,8,0,8"/>

                        <TextBlock Text="ID" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedConnection.Id}" Foreground="#B0B0B0" Background="#333337" Padding="5,3" Margin="0,0,0,6"/>

                        <TextBlock Text="Direction" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="DirectionCombo"
                                  SelectionChanged="DirectionCombo_SelectionChanged"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Tag="North" Content="North"/>
                            <ComboBoxItem Tag="South" Content="South"/>
                            <ComboBoxItem Tag="East" Content="East"/>
                            <ComboBoxItem Tag="West" Content="West"/>
                            <ComboBoxItem Tag="Northeast" Content="Northeast"/>
                            <ComboBoxItem Tag="Northwest" Content="Northwest"/>
                            <ComboBoxItem Tag="Southeast" Content="Southeast"/>
                            <ComboBoxItem Tag="Southwest" Content="Southwest"/>
                            <ComboBoxItem Tag="Up" Content="Up"/>
                            <ComboBoxItem Tag="Down" Content="Down"/>
                        </ComboBox>

                        <TextBlock Text="Aliases" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedConnectionAliases, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Exit Type" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ExitTypeCombo"
                                  SelectionChanged="ExitTypeCombo_SelectionChanged"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Door"/>
                        </ComboBox>

                        <CheckBox Content="One Way"
                                  IsChecked="{Binding SelectedConnectionIsOneWay}"
                                  Margin="0,0,0,6"/>

<!-- EVENNIA EXIT METADATA -->
                        <Expander Header="EVENNIA EXIT" IsExpanded="False"
                                  Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold"
                                  Background="#2D2D2D" BorderBrush="#3E3E42"
                                  Margin="0,8,0,0" Padding="4">
                            <StackPanel Margin="4,4,0,0">
<TextBlock Text="Key Name" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedConnectionKeyName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"/>
<TextBlock Text="Description" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedConnectionDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"/>

                                <TextBlock Text="Typeclass Path" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding SelectedConnectionTypeclassPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,6"/>
<TextBlock Text="Source Room ID" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedConnectionSrcId}" Foreground="#B0B0B0" FontSize="11"
                                           Margin="0,0,0,6"/>

                                <TextBlock Text="Destination Room ID" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedConnectionDstId}" Foreground="#B0B0B0" FontSize="11"
                                           Margin="0,0,0,6"/>
<!-- ALIASES -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Aliases" Foreground="#808080" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="+" Width="24" Height="22"
                                            Click="AddConnectionAlias_Click"
