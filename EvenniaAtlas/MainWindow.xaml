<Window x:Class="EvenniaAtlas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:EvenniaAtlas.Controls"
        xmlns:converters="clr-namespace:EvenniaAtlas.Converters"
        Title="{Binding TitleBarText}" Height="750" Width="1200"
        MinHeight="500" MinWidth="900"
        Background="#1E1E1E" FontFamily="Segoe UI"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <ToolBarTray Grid.Row="0" Background="#333337">
            <ToolBar Background="#333337">
                <Button Content="New" Click="New_Click" Width="48"/>
                <Button Content="Open" Click="Open_Click" Width="48"/>
                <Button Content="Save" Click="Save_Click" Width="48"/>
                <Button Content="Save As" Click="SaveAs_Click" Width="54"/>
                <Separator/>
                <Button Content="Undo" Click="Undo_Click" Width="48"/>
                <Button Content="Redo" Click="Redo_Click" Width="48"/>
                <Separator/>
                <Button x:Name="BuildBtn" Content="{Binding BuildModeText}" Click="BuildMode_Click"
                        FontWeight="SemiBold" Width="80"/>
                <Button x:Name="AutoRevBtn" Content="{Binding AutoReverseText}" Click="AutoReverse_Click"
                        Width="90"/>
                <Separator/>
                <Button Content="Floor Up" Click="FloorUp_Click" Width="62"/>
                <Button Content="Floor Down" Click="FloorDown_Click" Width="72"/>
                <TextBlock Text="{Binding FloorLabel}" Foreground="#CCA700" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0" FontSize="12"/>
                <Separator/>
                <Button Content="Delete" Click="Delete_Click" Width="52"/>
                <Separator/>
                <Button Content="Export Evennia" Click="Export_Click" Width="90"/>
            </ToolBar>
        </ToolBarTray>

        <!-- MAIN -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <controls:MapCanvas x:Name="MapCanvasControl" Grid.Column="0" DataContext="{Binding}"/>
            <GridSplitter Grid.Column="1" Width="3" Background="#474747"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#252526">
                <StackPanel Margin="10">

                    <StackPanel Visibility="{Binding IsRoomSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ROOM" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                        <TextBlock Text="ID" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedRoom.Id}" Foreground="#B0B0B0" Background="#333337" Padding="5,3" Margin="0,0,0,6"/>
                        <TextBlock Text="Title" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Type" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Description" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,3,0"><TextBlock Text="X" Foreground="#808080" FontSize="11"/><TextBlock Text="{Binding SelectedRoomX}" Foreground="#CCA700" FontWeight="SemiBold" Background="#333337" Padding="5,3"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,3,0"><TextBlock Text="Y" Foreground="#808080" FontSize="11"/><TextBlock Text="{Binding SelectedRoomY}" Foreground="#CCA700" FontWeight="SemiBold" Background="#333337" Padding="5,3"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Z" Foreground="#808080" FontSize="11"/><TextBlock Text="{Binding SelectedRoomZ}" Foreground="#CCA700" FontWeight="SemiBold" Background="#333337" Padding="5,3"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Tags" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomTags, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                        <TextBlock Text="Notes" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedRoomNotes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" Margin="0,0,0,6"/>
                        <TextBlock Text="EXITS" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,8,0,4"/>
                        <ItemsControl ItemsSource="{Binding RoomExits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#333337" BorderBrush="#3E3E42" BorderThickness="1" Padding="5,3" Margin="0,0,0,2" Cursor="Hand" MouseLeftButtonDown="ConnectionListItem_Click">
                                        <TextBlock FontSize="11"><Run Text="{Binding Direction}" Foreground="#CCA700" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding DestinationRoomId}" Foreground="#B0B0B0"/></TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>                    <StackPanel Visibility="{Binding IsConnectionSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="EXIT PROPERTIES" FontSize="13" FontWeight="SemiBold" Foreground="#E0E0E0" Margin="0,8,0,8"/>

                        <TextBlock Text="ID" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedConnection.Id}" Foreground="#B0B0B0" Background="#333337" Padding="5,3" Margin="0,0,0,6"/>

                        <TextBlock Text="Direction" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="DirectionCombo"
                                  SelectionChanged="DirectionCombo_SelectionChanged"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Tag="North" Content="North"/>
                            <ComboBoxItem Tag="South" Content="South"/>
                            <ComboBoxItem Tag="East" Content="East"/>
                            <ComboBoxItem Tag="West" Content="West"/>
                            <ComboBoxItem Tag="Northeast" Content="Northeast"/>
                            <ComboBoxItem Tag="Northwest" Content="Northwest"/>
                            <ComboBoxItem Tag="Southeast" Content="Southeast"/>
                            <ComboBoxItem Tag="Southwest" Content="Southwest"/>
                            <ComboBoxItem Tag="Up" Content="Up"/>
                            <ComboBoxItem Tag="Down" Content="Down"/>
                        </ComboBox>

                        <TextBlock Text="Aliases" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SelectedConnectionAliases, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6"/>

                        <TextBlock Text="Exit Type" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ExitTypeCombo"
                                  SelectionChanged="ExitTypeCombo_SelectionChanged"
                                  Margin="0,0,0,6">
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Door"/>
                        </ComboBox>

                        <CheckBox Content="One Way"
                                  IsChecked="{Binding SelectedConnectionIsOneWay}"
                                  Margin="0,0,0,6"/>

                        <StackPanel Visibility="{Binding ShowDoorProperties, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DOOR" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E0E0E0" Margin="0,8,0,6"/>

                            <TextBlock Text="Door Name" Foreground="#808080" FontSize="11" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding SelectedConnectionDoorName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6"/>

                            <CheckBox Content="Starts Open"
                                      IsChecked="{Binding SelectedConnectionStartsOpen}"
                                      Margin="0,0,0,4"/>

                            <CheckBox Content="Starts Closed"
                                      IsChecked="{Binding SelectedConnectionStartsClosed}"
                                      Margin="0,0,0,4"/>

                            <CheckBox Content="Starts Locked"
                                      IsChecked="{Binding SelectedConnectionStartsLocked}"
                                      Margin="0,0,0,4"/>

                            <TextBlock Text="Key ID" Foreground="#808080" FontSize="11" Margin="0,4,0,2"/>
                            <TextBox Text="{Binding SelectedConnectionKeyId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,6"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Select a room or connection to edit properties."
                               Foreground="#808080"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StatusText}" Foreground="#B0B0B0" FontSize="11"/>
                <TextBlock Text="   "/>
                <TextBlock Text="{Binding BuildModeText}" Foreground="#CCA700" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="   "/>
                <TextBlock Text="{Binding AutoReverseText}" Foreground="#75BEFF" FontSize="11"/>
                <TextBlock Text="   "/>
                <TextBlock Text="{Binding FloorLabel}" Foreground="#89D185" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
