<Window x:Class="EvenniaMapMaker.Dialogs.QuickEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit" Width="450" Height="350"
        WindowStartupLocation="CenterOwner"
        Background="#2D2D2D" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="FieldLabel" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
        <TextBox x:Name="EditBox" Grid.Row="1" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="#3C3C3C" Foreground="White" BorderBrush="#555"
                 Padding="6" FontSize="12"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Height="28" Margin="0,0,10,0"
                    Background="#555" Foreground="White" Click="Cancel_Click"/>
            <Button Content="OK" Width="80" Height="28"
                    Background="#007ACC" Foreground="White" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>