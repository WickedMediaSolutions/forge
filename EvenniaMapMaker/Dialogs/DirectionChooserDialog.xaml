<Window x:Class="EvenniaMapMaker.Dialogs.DirectionChooserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Direction" Width="320" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2D2D2D">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select Exit Direction:" FontSize="14" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,12"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="5">
            <Button Content="North" Tag="North" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="South" Tag="South" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="East" Tag="East" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="West" Tag="West" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="Northeast" Tag="Northeast" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="Northwest" Tag="Northwest" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="Southeast" Tag="Southeast" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="Southwest" Tag="Southwest" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="Up" Tag="Up" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
            <Button Content="Down" Tag="Down" Click="Direction_Click" Margin="4"
                    Background="#3C3C3C" Foreground="White" BorderBrush="#555555"/>
        </UniformGrid>
    </Grid>
</Window>